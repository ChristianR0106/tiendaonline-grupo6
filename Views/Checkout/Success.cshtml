@model URPOnline.Models.Order

<div class="container text-center my-5">
    @if (Model.Status == URPOnline.Models.OrderStatus.PAGADO)
    {
        <h1 class="text-success">¡Gracias por tu compra!</h1>
        <p>Tu pedido <strong>#@Model.Id</strong> ha sido procesado correctamente.</p>
        <p>ID de Pago Mercado Pago: <code>@Model.PaymentId</code></p>
    }
    else
    {
        <h1 class="text-warning">Pago Pendiente</h1>
        <p>Tu pedido <strong>#@Model.Id</strong> está en espera de confirmación.</p>
    }
</div>