[databases]
urponline = host=RDS_ENDPOINT port=5432 dbname=urponline
[pgbouncer]
listen_addr = 127.0.0.1
listen_port = 6432
pool_mode = transaction
max_client_conn = 400
default_pool_size = 30
reserve_pool_size = 5
auth_type = plain
auth_file = /etc/pgbouncer/userlist.txt
server_tls_sslmode = require
